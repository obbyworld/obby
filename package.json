{
  "name": "obby-client",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/obbyworld/obby",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --outDir dist",
    "lint": "biome lint --write",
    "lint:unsafe": "biome lint --write --unsafe",
    "format": "biome format --write",
    "check": "biome check",
    "fix": "biome check --write",
    "fix:unsafe": "biome check --write --unsafe",
    "preview": "vite preview",
    "commit-hook-install": "lefthook install",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "ci": "npm run format && npm run fix:unsafe && npm run i18n:extract && npm run i18n:compile && npm run test && npm run build",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "i18n:check": "lingui extract --clean && git diff --exit-code src/locales/en/messages.po || (echo '\\nNew translatable strings detected. Commit src/locales/en/messages.po or run: npm run i18n:extract && npm run i18n:compile' && exit 1)",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo fmt --manifest-path src-tauri/plugins/share-sheet/Cargo.toml --all -- --check && cargo fmt --manifest-path src-tauri/plugins/ios-keyboard/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --no-deps -- -D warnings && cargo clippy --manifest-path src-tauri/plugins/share-sheet/Cargo.toml --all-targets --no-deps -- -D warnings && cargo clippy --manifest-path src-tauri/plugins/ios-keyboard/Cargo.toml --all-targets --no-deps -- -D warnings",
    "docs:format": "prettier --write \"**/*.{yml,yaml,md}\"",
    "docs:check": "prettier --check \"**/*.{yml,yaml,md}\"",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#.serena\" \"#src-tauri/target\" \"#src-tauri/plugins/*/target\" \"#src-tauri/plugins/*/.tauri\" \"#src-tauri/plugins/*/permissions/autogenerated\"",
    "docs:lint:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#dist\" \"#.serena\" \"#src-tauri/target\" \"#src-tauri/plugins/*/target\" \"#src-tauri/plugins/*/.tauri\" \"#src-tauri/plugins/*/permissions/autogenerated\"",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --browser --no-file-parallelism",
    "android:dev": "tauri android dev --config src-tauri/tauri.android.conf.json --no-dev-server-wait",
    "android:build": "tauri android build --apk --debug",
    "android:release": "tauri android build --apk",
    "ios:dev": "bash scripts/ios-dev.sh",
    "ios:build": "tauri ios build --debug --export-method debugging",
    "gen-certs": "bash scripts/setup-dev-certs.sh",
    "run-dev-stack": "docker compose --profile testing up --remove-orphans",
    "stop-dev-stack": "docker compose --profile testing down --remove-orphans",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@lingui/core": "^5.9.5",
    "@lingui/macro": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-haptics": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.2.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.2.1",
    "@types/uuid": "^10.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.22",
    "dompurify": "^3.4.14",
    "emoji-datasource": "^16.0.0",
    "emoji-picker-react": "^4.19.1",
    "exifr": "^7.1.3",
    "fuse.js": "^7.5.0",
    "gh-pages": "^6.3.0",
    "highlight.js": "^11.12.0",
    "html-react-parser": "^5.2.17",
    "immer": "^11.1.18",
    "marked": "^16.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-pdf": "^10.5.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.3",
    "react-swipeable": "^7.0.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/format-po": "^5.9.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "lefthook": "^1.11.10",
    "markdownlint-cli2": "^0.23.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
